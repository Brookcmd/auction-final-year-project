PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL / Neon Lakebase Postgres)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Redis Configuration (Real-time state & concurrency locks)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# Authentication & Security
JWT_ACCESS_SECRET="bidora_jwt_access_secret_super_secure_key_2026"
JWT_REFRESH_SECRET="bidora_jwt_refresh_secret_rotation_key_2026"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Client CORS
FRONTEND_URL="http://localhost:3000"

# Bidding & Auction Engine Rules
DEFAULT_ANTI_SNIPING_SECONDS=30
DEFAULT_ANTI_SNIPING_TRIGGER_WINDOW=30
